    "section_custom_code_QGdGxk": {
      "type": "section-custom-code",
      "disabled": true,
      "name": "Custom code",
      "settings": {
        "code": "<!-- Pure Black CTA Section -->\n<div class=\"pure-cta\" id=\"cta-pure\">\n  <div class=\"pure-icons-row\" id=\"icons-pure\">\n    <div class=\"pure-box\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0864/3320/2454/files/return_3_1.png?v=1742162916\" alt=\"Unique Box\" />\n      <span>Every box = unique. No two are the same.</span>\n    </div>\n    <div class=\"pure-box\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0864/3320/2454/files/king_1.png?v=1742162436\" alt=\"Vintage Hunters\" />\n      <span>50k+ vintage hunters levelling up their fits.</span>\n    </div>\n    <div class=\"pure-box\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0864/3320/2454/files/thunder_1.png?v=1742162535\" alt=\"Free Swap\" />\n      <span>Doesn’t fit or vibe? Swap it free.</span>\n    </div>\n  </div>\n\n  <div class=\"pure-action\" id=\"action-pure\">\n    <span class=\"pure-arrow-text\">\n      Hit \n      <img src=\"https://cdn.shopify.com/s/files/1/0864/3320/2454/files/Untitled_design_66_2.png?v=1742163199\" alt=\"Down Arrow\" class=\"pure-arrow\" />\n    </span>\n    <a href=\"#shopify-section-template--25420582682902__main\" class=\"pure-link\">Get My Box</a>\n    <p>before it’s too late.</p>\n  </div>\n</div>\n\n<style>\n/* Overall CTA container */\n.pure-cta {\n  text-align: center;\n  background: #fff;\n  color: #000;\n  padding: 10px;\n  font-size: 16px;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n/* Icons row */\n.pure-icons-row {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 8px;\n}\n\n/* Individual icon + text boxes */\n.pure-box {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: max-content;\n  padding: 8px 12px;\n  border: 1px solid #000;\n  font-size: 14px;\n  color: #000;\n}\n\n.pure-box img {\n  width: 22px;\n  height: 22px;\n  margin-right: 6px;\n}\n\n/* CTA Action Section */\n.pure-action {\n  margin-top: 6px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  font-size: 18px;\n  color: #000;\n}\n\n/* “Hit” text and arrow */\n.pure-arrow-text {\n  font-size: 20px;\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  color: #000;\n}\n\n/* Arrow Icon */\n.pure-arrow {\n  width: 30px;\n  height: 30px;\n}\n\n/* CTA Link */\n.pure-link {\n  display: inline-block;\n  font-size: 16px;\n  text-decoration: none;\n  border: 1px solid #000;\n  color: #000;\n  background: transparent;\n  padding: 8px 30px;\n  margin: 4px 0 2px 0;\n}\n\n/* No hover color — stays the same */\n.pure-link:hover,\n.pure-link:focus,\n.pure-link:active {\n  color: #000;\n  border-color: #000;\n  background: transparent;\n}\n\n/* Subtext */\n.pure-action p {\n  margin-top: 2px;\n  font-size: 14px;\n  color: #000;\n}\n\n/* Responsive layout */\n@media (max-width: 768px) {\n  .pure-icons-row {\n    flex-direction: column;\n    gap: 5px;\n  }\n  .pure-box {\n    width: 100%;\n    padding: 6px;\n    font-size: 13px;\n  }\n  .pure-box img {\n    width: 18px;\n    height: 18px;\n  }\n  .pure-arrow {\n    width: 16px;\n    height: 16px;\n  }\n}\n</style>",
