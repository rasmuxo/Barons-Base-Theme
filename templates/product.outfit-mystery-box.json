          "type": "question",
          "settings": {
            "default_open": false,
            "title": "🌱 Is vintage clothing really sustainable?",
            "content": "<p>1000% yes. Buying vintage = <strong>saving the planet</strong>.</p><p>♻️ <strong>Every purchase reduces textile waste & cuts down on fast fashion pollution.</strong><br/>🌏 <strong>Vintage clothing = timeless quality that lasts for decades.</strong><br/>💚 <strong>Your style choice makes a difference.</strong></p><p>💡 <strong>Feel good. Look better. Impact the planet.</strong></p>",
            "show_icon": false,
