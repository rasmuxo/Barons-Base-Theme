    "section_accordion_group_6fKUCT": {
      "type": "section-accordion-group",
      "blocks": {
        "heading_P7cFwj": {
          "type": "heading",
          "settings": {
            "title": "FAQS from the Past"
          }
        },
        "question_JG9M3X": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "What if I don’t like what I receive?",
            "content": "<p>We make sure you do. Our <strong>expert in-house stylists curate each outfit based on your preferences</strong>, ensuring you receive high-quality, handpicked vintage pieces tailored to your unique style.</p><p><strong>ALL SALES ARE FINAL.</strong></p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": "#545454"
          }
        },
        "question_7gcwrr": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "Why is vintage worth more?",
            "content": "<p>Each outfit includes <strong>3-5 handpicked, premium vintage pieces</strong>, curated to your aesthetic. </p><p>If purchased separately, these items would retail for <strong>over $300</strong>, meaning you’re getting an <strong>exclusive wardrobe upgrade at nearly 50% off retail value</strong>.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": "#545454"
          }
        },
        "question_WbbBrm": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "What if something doesn’t fit me?",
            "content": "<p>No worries—<strong>we've got you covered</strong>.</p><p><strong>Personalized Sizing</strong> – Before shipping, we match you with items that fit your exact size & style.<br/><strong>Easy Exchanges</strong> – If anything doesn’t fit, we offer hassle-free swaps.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": "#545454"
          }
        },
        "question_KzM3BK": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "How long does shipping take?",
            "content": "<p>We move fast—because you shouldn’t have to wait.</p><p>📦 <strong>Orders ship within 24-48 hours.</strong><br/>📍 <strong>Delivery times:</strong></p><ul><li><strong>US:</strong> 3-5 business days</li><li><strong>International:</strong> 5-10 business days</li></ul>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": "#545454"
          }
        },
        "question_VYYP4y": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "Are shoes included?",
            "content": "<p>No, but here’s why that’s a good thing: <strong>you control your entire look</strong>.</p><p>Our curated outfit boxes let <strong>YOU</strong> pick and build your perfect fit. But if you ever need styling advice on what shoes to pair with your outfit, our team is happy to help.</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": "#545454"
          }
        },
        "question_6XgPxD": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "Are these items new or pre-owned?",
            "content": "<p>Every piece has been <strong>personally curated</strong> carefully by our team.</p><p>Most items are <strong>gently pre-loved</strong>, while some are <strong>deadstock</strong> (vintage but never worn, sometimes even with original tags).</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": "#545454"
          }
        },
        "question_qEqjHc": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "Is vintage clothing really sustainable?",
            "content": "<p>100% yes.</p><p><strong>Every purchase reduces textile waste & cuts down on fast fashion pollution.</strong></p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": "#545454"
          }
        }
      },
